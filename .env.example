# Copy to .env for local development. Never commit .env.

# Bring your own key: users enter their own Google Gemini key (and optional Hugging Face token)
# in the app. The keys below are used ONLY when ALLOW_SERVER_KEYS=1 — for local development.
# Never set ALLOW_SERVER_KEYS=1 on a public deployment.
ALLOW_SERVER_KEYS=0
GOOGLE_API_KEY=
HF_TOKEN=
# GEMINI_MODEL=gemini-flash-latest

# PostgreSQL connection string. Leave empty locally to use bloggraph.db (SQLite).
# Required on Render, e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Max successful blogs per user per 24 hours (0 = unlimited)
DAILY_GENERATION_LIMIT=0

# 0 = skip image generation (images cost far more Hugging Face credits than text)
ENABLE_IMAGES=1

# Optional: image model and saving blogs as .md files locally
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# SAVE_MARKDOWN_FILES=1
